# Astro Clock - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# Database Configuration (Required)
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# 
# For local development with standard PostgreSQL:
# PG_URL=postgresql://postgres:password@localhost:5432/astrology
#
# For TimescaleDB (recommended for production):
# PG_URL=postgresql://user:password@timescale-host:5432/astrology
#
# Note: This application is designed for TimescaleDB with hypertables.
# Standard PostgreSQL will work but without time-series optimizations.
PG_URL=postgresql://user:password@localhost:5432/astrology

# Test database connection string (used by just test-db-setup and just test-integration)
# Should point to a separate database to avoid polluting development data
TEST_PG_URL=postgresql://user:password@localhost:5432/astrology_test

# ============================================================================
# Logging Configuration (Optional)
# ============================================================================

# Rust log level - controls verbosity of logging output
# Options: trace, debug, info, warn, error
# Default: info
RUST_LOG=info

# ============================================================================
# Swiss Ephemeris Configuration (Optional)
# ============================================================================

# Path to Swiss Ephemeris data files
# These files are required for accurate astronomical calculations
# Download them with: just download-ephemeris
# Default: ./data
SE_EPHE_PATH=./data

# ============================================================================
# Example Usage
# ============================================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env with your database credentials
#
# 3. Source the environment:
#    source .env
#
# 4. Verify connection:
#    just db-setup
#
# 5. Run migrations:
#    just migrate
#
# ============================================================================
